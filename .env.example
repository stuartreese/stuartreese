# Contact form (optional). Without RESEND_API_KEY the form politely falls back to a mailto link.
# 1. Create a free account at https://resend.com and generate an API key.
# 2. Add these in Vercel: Project > Settings > Environment Variables.
RESEND_API_KEY=
# Where messages are delivered. Defaults to stuartreese9@gmail.com.
CONTACT_TO_EMAIL=
# Sender address. Resend's shared onboarding sender works with no DNS setup.
# To send from your own domain, verify stuartreese.com in Resend and use something like "Stuart Reese <hello@stuartreese.com>".
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>

# Live running stats (optional). Without these the Running section shows a plain Strava link.
# Run `npm run strava:auth` once to get the refresh token. Details in README.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# SEO (optional). Paste the code from Google Search Console's "HTML tag" method, just the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
